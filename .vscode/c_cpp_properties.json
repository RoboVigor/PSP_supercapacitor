{
  "configurations": [
    {
      "name": "windows-gcc-x64",
      "includePath": [
        "${workspaceFolder}/**",
        "${workspaceFolder}/Drivers/STM32G4xx_HAL_Driver/Inc"
      ],
      "defines": [
        "_DEBUG",
        "UNICODE",
        "_UNICODE",
        "STM32G474xx",
        "USE_HAL_DRIVER"
      ],
      "windowsSdkVersion": "10.0.22621.0",
      "compilerPath": "arm-none-eabi-gcc.exe",
      "cStandard": "${default}",
      "cppStandard": "${default}",
      "intelliSenseMode": "gcc-arm",
      "configurationProvider": "ms-vscode.makefile-tools"
    }
  ],
  "version": 4
}